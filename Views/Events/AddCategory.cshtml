@model RaceDay.MVC.Models.CategoryViewModel

@{
    ViewData["Title"] = "Add Category";
}

<h2>Add Event Category</h2>

<form asp-action="AddCategory"
      asp-route-id="@ViewBag.EventID"
      method="post">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label">
            Category Name
        </label>
        <input asp-for="Name" class="form-control"
               placeholder="e.g. 10km Open" />
        <span asp-validation-for="Name"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Distance" class="form-label">
            Distance (km)
        </label>
        <input asp-for="Distance" type="number"
               step="0.01" min="0.01"
               class="form-control" />
        <span asp-validation-for="Distance"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="AgeRestriction" class="form-label">
            Age Restriction
        </label>
        <input asp-for="AgeRestriction"
               class="form-control"
               placeholder="e.g. 18+" />
    </div>

    <button type="submit" class="btn btn-primary">
        Save Category
    </button>

    <a asp-action="Details"
       asp-route-id="@ViewBag.EventID"
       class="btn btn-secondary">
        Cancel
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}