@model RaceDay.MVC.Models.EventDetailsViewModel

@{
    ViewData["Title"] = "Event Details";
    var role = Context.Session.GetString("UserRole");
}

<h2>@Model.Name</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <p><strong>Description:</strong> @Model.Description</p>
        <p><strong>Location:</strong> @Model.Location</p>
        <p><strong>Date:</strong> @Model.EventDate.ToString("dd MMMM yyyy HH:mm")</p>
        <p><strong>Event Type:</strong> @Model.EventType</p>
        <p><strong>Route:</strong> @Model.RouteDetails</p>
        <p><strong>Weather:</strong> @Model.WeatherInfo</p>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Event Categories</h3>

    @if (role == "Organiser")
    {
        <a asp-action="AddCategory"
           asp-route-id="@Model.EventID"
           class="btn btn-primary">
            Add Category
        </a>
    }
</div>

@if (Model.Categories != null && Model.Categories.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Category</th>
                <th>Distance (km)</th>
                <th>Age Restriction</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model.Categories)
            {
                <tr>
                    <td>@category.Name</td>
                    <td>@category.Distance</td>
                    <td>@category.AgeRestriction</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No categories have been added to this event yet.</p>
}

<a asp-action="Index" class="btn btn-secondary">Back to Events</a>