@model List<RaceDay.MVC.Models.MyResultViewModel>

@{
    ViewData["Title"] = "My Race Results";
}

<h2>My Race Results</h2>

<p>Track your performance and see your finishing positions.</p>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Category</th>
                    <th>Finish Time</th>
                    <th>Position</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var result in Model)
                {
                    <tr>
                        <td>@result.EventName</td>
                        <td>@result.CategoryName</td>
                        <td>@result.FinishTime</td>
                        <td>
                            <span class="badge bg-primary">
                                @result.Position
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        You do not have any published race results yet.
    </div>
}